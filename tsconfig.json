{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"allowJs": false,
		"checkJs": false,
		"strict": true,
		"skipLibCheck": true,
		"types": ["node", "$app/types"],
		"erasableSyntaxOnly": true,
		"allowArbitraryExtensions": true,
		"noUncheckedIndexedAccess": true
	},
	"include": ["src", "scripts", "e2e", "*"],
	"exclude": ["src/service-worker"]
}
