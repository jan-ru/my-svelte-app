{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"allowJs": false,
		"checkJs": false,
		"strict": true,
		"skipLibCheck": true,
		"types": [
			"node",
			"$app/types"
		],
		"erasableSyntaxOnly": true
	},
	"include": [
		"src",
		"scripts",
		"*"
	],
	"exclude": [
		"src/service-worker"
	]
}
