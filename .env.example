# Copy to .env for local development. Never commit real values.
# Sign in with Google (ADR-014): an OAuth client of type "Web application", callback
# http://localhost:5173/login/google/callback, and your own address in ALLOWED_EMAILS
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAILS=
# Page access (ADR-015): admins get every page and /settings, and must also be on ALLOWED_EMAILS.
# PAGE_ACCESS is made on /settings, e.g. a@x.test=*; b@y.test=/financials,/countries. Unset: only admins get pages.
ADMIN_EMAILS=
PAGE_ACCESS=
SESSION_SECRET=
FMP_API_KEY=
# Optional: only needed for the Eulerpool source on /financials
EULERPOOL_API_KEY=
# 32+ random characters, e.g. openssl rand -hex 32; unset turns the page cache off
ISR_BYPASS_TOKEN=
