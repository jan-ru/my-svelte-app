{
  "name": "my-svelte-app",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check:data": "vitest run --config vitest.live.config.ts",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "build:crosswalk": "node scripts/build-crosswalk.ts",
    "build:companies": "node scripts/build-companies.ts",
    "check:ts-only": "node scripts/check-no-js.ts"
  },
  "devDependencies": {
    "@sveltejs/adapter-vercel": "^7.0.1",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.5",
    "svelte": "^5.55.7",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "imports": {
    "#lib": "./src/lib/index.ts",
    "#lib/*.svelte": "./src/lib/*.svelte",
    "#lib/*.json": "./src/lib/*.json",
    "#lib/*": {
      "types": "./src/lib/*.ts",
      "default": "./src/lib/*"
    }
  },
  "keywords": [],
  "author": "JRM",
  "license": "MIT",
  "description": "Fetch multiples from NYU database"
}
