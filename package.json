{
  "name": "my-svelte-app",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:data": "vitest run --config vitest.live.config.ts",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "build:crosswalk": "node scripts/build-crosswalk.ts",
    "build:companies": "node scripts/build-companies.ts",
    "build:gdp": "node scripts/build-gdp.ts",
    "check:ts-only": "node scripts/check-no-js.ts"
  },
  "devDependencies": {
    "@sveltejs/adapter-vercel": "^7.0.1",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "svelte": "^5.55.7",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource-variable/public-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@vercel/analytics": "^2.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yahoo-finance2": "4.0.5"
  },
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "imports": {
    "#lib": "./src/lib/index.ts",
    "#lib/*.svelte": "./src/lib/*.svelte",
    "#lib/*.json": "./src/lib/*.json",
    "#lib/*": {
      "types": "./src/lib/*.ts",
      "default": "./src/lib/*"
    }
  },
  "keywords": [],
  "author": "JRM",
  "license": "MIT",
  "description": "Fetch multiples from NYU database",
  "overrides": {
    "@vercel/analytics": {
      "@sveltejs/kit": "$@sveltejs/kit"
    }
  }
}
