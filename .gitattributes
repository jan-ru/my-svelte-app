# Text files are LF in the repository and in every working copy, Windows included, whatever core.autocrlf says.
# Several tests read committed files (the CHANGELOG, the ADRs, the generated stylesheets) and Prettier expects LF.
* text=auto eol=lf

# Windows scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files are never touched
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.xlsx binary
*.xls binary
*.woff binary
*.woff2 binary
